# Copy to .env.local for local development, and add the same keys in Vercel
# (Project → Settings → Environment Variables) for production.

# Root URL of the headless WordPress site (no trailing slash).
# While unset, local development shows sample blog posts; production shows an empty blog.
WORDPRESS_URL=https://cms.manageandresolve.com

# Shared secret WordPress sends in the `x-revalidate-secret` header when it calls
# POST /api/revalidate after a post is published or updated. Use a long random string.
WORDPRESS_REVALIDATE_SECRET=

# Form delivery to the WordPress "Manage & Resolve — Website Submissions" plugin.
# A WordPress user with the "Website forms (API only)" role, and an Application
# Password created for that user (Users → Edit user → Application Passwords).
# Server-side only — never exposed to the browser. In production, forms show a
# "please email us directly" message until these are set, so nothing is lost silently.
WORDPRESS_FORMS_USER=website-forms
WORDPRESS_FORMS_APP_PASSWORD=

# Paystack (Dashboard → Settings → API Keys & Webhooks). Use the sk_test_ key while testing,
# the sk_live_ key in production. Server-side only. Also set the Webhook URL there to:
#   https://www.manageandresolve.com/api/paystack/webhook
PAYSTACK_SECRET_KEY=
